  "forms": [
    { "word": "탑",     "cond": [["max_height", ">=", 9], ["avg_height", ">=", 5.5]] },
    { "word": "미궁",   "cond": [["cells", ">=", 420]] },
    { "word": "마당",   "cond": [["keep_columns", ">=", 10]] },
    { "word": "옥상",   "cond": [["group.farm", ">=", 12], ["max_height", ">=", 4]] },
    { "word": "뒷골목", "cond": [["notoriety", ">=", 35]] },
    { "word": "골목",   "cond": [["cells", ">=", 120]] },
    { "word": "판자촌", "cond": [["id.mat_share", ">=", 0.5], ["mat.scrap", ">=", 20]] },
    { "word": "모퉁이", "cond": [] }
  ],
  "patterns": [
    { "text": "천 개의 {noun1}", "cond": [["id.top1", ">=", 12], ["id.lead", ">=", 1.8]] },
    { "text": "{noun1}과(와) {noun2}의 {form}", "cond": [["id.top2", ">=", 4], ["id.lead", "<=", 1.6]] },
    { "text": "{adj1} {mat} {form}", "cond": [["id.top1", ">=", 2]] },
    { "text": "{mat} {form}", "cond": [] }
  ],
  "titles": [
    { "title": "대장",   "cond": [["population", "<", 40]] },
    { "title": "따거",   "cond": [["group.vice", ">=", 3], ["notoriety", ">=", 30]] },
    { "title": "어르신", "cond": [["dominant", "==", "farm"], ["policy.care.mutual", ">=", 1], ["prestige", ">=", 45]] },
    { "title": "촌장",   "cond": [["dominant", "==", "farm"]] },
    { "title": "회장님", "cond": [["dominant", "==", "fun"], ["prestige", ">=", 35]] },
    { "title": "사장님", "cond": [["dominant", "==", "fun"]] },
    { "title": "공장장", "cond": [["dominant", "==", "make"], ["group.make", ">=", 25]] },
    { "title": "반장",   "cond": [["dominant", "==", "make"]] },
    { "title": "큰형님", "cond": [["dominant", "==", "vice"]] }
  ]
