        { "label": "밀항 알선꾼에게 넘긴다", "hint": "돈이 생긴다. 사람이 할 짓은 아니다.", "tags": ["vice", "money"], "effects": [["money", "+", 40], ["notoriety", "+", 5], ["prestige", "-", 4]] }
      ] },
    "care_cough": {
