      ] },
    "grow_tent_yard": {
      "speaker": "대문 앞 사람들", "title": "빈 땅이 있는데", "weight": 3, "cooldown": 8,
      "cond": [["waiting", ">=", 6], ["keep_columns", ">=", 2]],
      "body": "대문 앞에서 사흘을 기다린 사람들이 비워 둔 마당에 천막을 쳤다. \"빈 땅이 있는데 왜 우리는 밖에서 자야 합니까.\" 틀린 말은 아니다.",
      "choices": [
        { "label": "마당을 내준다", "hint": "비운 터 3칸이 풀린다. 위신 −", "tags": ["growth"], "effects": [["zone_clear", "keep", 3], ["morale", "+", 2], ["prestige", "-", 2]] },
