        { "label": "약초방에 맡긴다", "hint": "약초방이 있어야 한다. 민심 +", "tags": ["green", "farm"], "needs": [["count.herb_shop", ">=", 1]], "needs_hint": "약초방이 없다.", "effects": [["morale", "+", 2]] },
        { "label": "문틈을 더 막는다", "hint": "민심 −. 그 방은 곧 빌지도 모른다.", "tags": ["refuse", "make"], "effects": [["morale", "-", 3], ["chance", 0.3, [["leave", "dependent", 1, "sick"], ["log", "2층 끝방이 비었다. 아무도 어디로 갔는지 묻지 않았다."]]]] }
      ] },

