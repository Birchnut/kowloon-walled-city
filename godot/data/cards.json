      ] },
    "up_tribute_raise": {
      "speaker": "윗선의 사람", "title": "물가가 올랐습니다", "weight": 3, "cooldown": 8,
      "cond": [["flag.tribute", ">", 0], ["flag.tribute", "<", 0.45]],
      "body": "\"물가가 올랐습니다, 따거.\" 상납을 1할 더 올리잔다. 대신 단속 소식은 하루 먼저 알려 주겠단다. 거절하는 법은 설명서에 없다.",
      "choices": [
        { "label": "올려 준다", "hint": "상납 +1할. 악명은 그들이 눌러 준다.", "tags": ["debt", "vice"], "effects": [["flag+", "tribute", 0.1], ["notoriety", "-", 3]] },
        { "label": "가게 하나를 떼어 준다", "hint": "음성 가게 하나가 그들 것이 된다.", "tags": ["money"], "effects": [["close_business", "vice", 1], ["money", "-", 50]] },
        { "label": "장부를 들고 경찰서에 간다", "hint": "끝장을 본다. 다 잃고 이름을 되찾는다.", "tags": ["clean", "order"], "effects": [["flag", "tribute", 0], ["flag", "forced_title", ""], ["close_business", "vice", 3], ["notoriety", "-", 20], ["prestige", "+", 6], ["morale", "-", 5], ["money", "-", 200]] }
      ] },

