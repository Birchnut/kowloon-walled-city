      ] },

    "up_first_contact": {
      "speaker": "윗선의 사람", "title": "과일 바구니", "weight": 0, "once": true,
      "body": "검은 차가 대문 앞에 섰다. 내린 사람은 과일 바구니를 들었다. \"가게가 셋이면 이제 '사업'입니다. 사업에는 보험이 필요하지요. 오늘부터 형님이라 부르겠습니다. 형님도 저희를 형님이라 부르시고.\"",
      "choices": [
        { "label": "바구니를 받는다", "hint": "큰돈 +. 앞으로 거두는 돈의 2할은 상납. 호칭이 바뀐다.", "tags": ["vice", "money", "debt"], "effects": [["money", "+", 300], ["flag", "tribute", 0.2], ["flag", "uplink", 1], ["title", "따거"], ["notoriety", "+", 8]] },
        { "label": "돌려보낸다", "hint": "그들은 다시 온다. 다른 얼굴로.", "tags": ["clean", "refuse"], "effects": [["flag", "uplink", 1], ["notoriety", "+", 2], ["queue_card", "out_raid", 3]] }
      ] },
    "up_ban_warning": {
      "speaker": "윗선의 사람", "title": "따거, 이러시면 안 됩니다", "weight": 0, "cooldown": 3,
      "body": "\"따거, 이러시면 안 됩니다.\" 과일 바구니 대신 장부를 들고 왔다. 지금까지 받은 돈, 봐준 단속, 빌려준 사람. \"금지는 저희가 정합니다. 따거는 서명만 하시고.\"",
      "choices": [
        { "label": "금지를 거둔다", "hint": "음성 허가가 되돌아간다.", "tags": ["vice", "debt"], "effects": [["policy", "permit.vice", "allow"], ["morale", "-", 1]] },
        { "label": "버틴다", "hint": "상납도 호칭도 끊는다. 그들도 가만있지 않는다.", "tags": ["clean", "order"], "effects": [["flag", "tribute", 0], ["flag", "forced_title", ""], ["money", "-", 150], ["notoriety", "-", 10], ["morale", "-", 4], ["prestige", "+", 5], ["queue_card", "out_raid", 2]] }
      ] },
    "up_dictate_intake": {
      "speaker": "윗선의 사람", "title": "부탁하는 말투", "weight": 4, "cooldown": 9,
      "cond": [["flag.tribute", ">", 0], ["policy.intake", "!=", "workers"]],
      "body": "\"따거, 사람이 모자랍니다. 콜센터도 하우스도 손이 달려요. 입주는 '일꾼 우선'으로 하시지요. 노인네들은… 따거가 알아서 하시고.\" 부탁하는 말투인데 부탁이 아니다.",
      "choices": [
        { "label": "그렇게 한다", "hint": "입주가 '일꾼 우선'으로 바뀐다. 사례금 +", "tags": ["vice", "debt", "money"], "effects": [["policy", "intake", "workers"], ["money", "+", 80], ["morale", "-", 3]] },
