      ] },
    "grow_cage_offer": {
      "speaker": "집주인 탁씨", "title": "저는 그걸 효율이라 부릅니다", "weight": 3, "cooldown": 9,
      "cond": [["waiting", ">=", 5], ["flag.cage_ok", "<", 1], ["flag.no_cage", "<", 1]],
      "body": "집주인 탁씨가 철망 견본을 가져왔다. \"방 하나를 넷으로 쪼개면 대문 앞 줄이 사라집니다. 침대는 3단까지 됩니다. 저는 그걸 '효율'이라고 부릅니다.\"",
      "choices": [
