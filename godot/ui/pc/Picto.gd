var shape: String = "dot":
	set(v):
		shape = v
		queue_redraw()
var color: Color = Color(0.94, 0.9, 0.82):
	set(v):
		color = v
		queue_redraw()
var accent: Color = Color(1.0, 0.88, 0.54):
	set(v):
		accent = v
		queue_redraw()
var px: int = 2:
	set(v):
		px = maxi(1, v)
		custom_minimum_size = Vector2(12 * px, 12 * px)
		queue_redraw()
var outline: bool = true


static func make(n: String, c: Color = Color(0.94, 0.9, 0.82), scale: int = 2, acc: Variant = null) -> Picto:
	var p := Picto.new()
	p.shape = n
	p.color = c
	if acc is Color:
		p.accent = acc
	p.px = scale
	return p


static func has(n: String) -> bool:
	return P.has(n)


func _init() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	custom_minimum_size = Vector2(24, 24)
	size_flags_vertical = Control.SIZE_SHRINK_CENTER
	size_flags_horizontal = Control.SIZE_SHRINK_CENTER


func _draw() -> void:
	var rows: Array = P.get(shape, P["dot"])
	var off := ((size - Vector2(12 * px, 12 * px)) * 0.5).floor()
	var dark := Color(0.02, 0.03, 0.05, 0.92)
	var hole := Color(color.r * 0.25, color.g * 0.25, color.b * 0.3, 1.0)
	var filled := {}
	for y in rows.size():
		var r: String = rows[y]
		for x in r.length():
			if r[x] != ".":
				filled[Vector2i(x + 1, y + 1)] = r[x]
	if outline:
		for k: Vector2i in filled:
			for d: Vector2i in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
				var n: Vector2i = k + d
				if not filled.has(n):
					draw_rect(Rect2(off + Vector2(n) * px, Vector2(px, px)), dark)
	for k2: Vector2i in filled:
		var ch: String = filled[k2]
		var c := color
		if ch == "+":
			c = accent
		elif ch == "o":
			c = hole
		draw_rect(Rect2(off + Vector2(k2) * px, Vector2(px, px)), c)
